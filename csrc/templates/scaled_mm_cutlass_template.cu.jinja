// Quantizing launcher: q = quantize(T(act(...)) * out_mul), 8-bit out in the operands'
// format (int8: rint and clamp to ±127; fp8: e4m3 RNE, saturating), for a consumer
// GEMM with a static input scale.  ``round_dtype``: 0 = fp16, 1 = bf16, the dtype the
// fp output would have had (and the bias's dtype).

void {{ quant_func_name }}(TensorView output, TensorView A, TensorView B, TensorView a_scale,
                           TensorView b_scale, Optional bias_opt, TensorView out_mul,
                           int64_t activation_type, int64_t round_dtype) {
    const Problem p = checkOperands(output, A, B, a_scale, b_scale);
    TVM_FFI_ICHECK(isOperandType(output.dtype()))
        << "scaled_mm_quant: output must be " << kOperandName;
    CHECK_INPUT(out_mul);
    CHECK_CONTIGUOUS_INPUT(out_mul);
    TVM_FFI_ICHECK(out_mul.dtype().code == kDLFloat && out_mul.dtype().bits == 32 &&
                   out_mul.numel() == p.N)
        << "scaled_mm_quant: out_mul needs N=" << p.N << " float32 values, got "
        << out_mul.numel();
    TVM_FFI_ICHECK(round_dtype == 0 || round_dtype == 1)
        << "scaled_mm_quant: round_dtype must be 0 (fp16) or 1 (bf16), got " << round_dtype;
    if (p.M == 0) {
        return;
    }

    cudaStream_t stream = get_stream(A.device());

    auto launch = [&](auto tag) {
        using CutlassType = decltype(tag);
        const CutlassType* bias_ptr = nullptr;
        if (bias_opt.has_value()) {
            TensorView bias = bias_opt.value();
            CHECK_INPUT(bias);
            TVM_FFI_ICHECK(bias.numel() == p.N) << "scaled_mm_quant: bias needs N elements";
            TVM_FFI_ICHECK(bias.dtype().code == (round_dtype == 0 ? kDLFloat : kDLBfloat) &&
                           bias.dtype().bits == 16)
                << "scaled_mm_quant: bias must have the round dtype";
            bias_ptr = reinterpret_cast<const CutlassType*>(bias.data_ptr());
        }
        return oasr::scaled_mm::dispatchScaledMmQuant<Config, CutlassType>(
            static_cast<int>(activation_type), static_cast<const ElementAB*>(A.data_ptr()),
            static_cast<const ElementAB*>(B.data_ptr()),
            static_cast<const float*>(a_scale.data_ptr()), p.a_per_token,
            static_cast<const float*>(b_scale.data_ptr()), bias_ptr,
            static_cast<const float*>(out_mul.data_ptr()),
            static_cast<ElementAB*>(output.data_ptr()), p.M, p.N, p.K, p.K, p.K, p.N, stream);
    };
    auto status = round_dtype == 0 ? launch(cutlass::half_t{}) : launch(cutlass::bfloat16_t{});
    TVM_FFI_ICHECK(status == oasr::scaled_mm::ScaledMmStatus::SUCCESS)
        << "scaled_mm_quant kernel failed (status " << static_cast<int>(status)
        << ") for M=" << p.M << " N=" << p.N << " K=" << p.K << " activation=" << activation_type;
}

