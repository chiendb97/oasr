// The DLPack dtype of the 8-bit operands (and of a quantizing launch's output).
constexpr bool kFp8 = {{ "true" if fp8 else "false" }};
constexpr const char* kOperandName = kFp8 ? "float8_e4m3fn" : "int8";

namespace {

bool isOperandType(DLDataType t) {
    return kFp8 ? (t.code == kDLFloat8_e4m3fn && t.bits == 8)
                : (t.code == kDLInt && t.bits == 8);
}

template <typename T>
struct ToCutlassType {
    using type = T;
};

template <>
struct ToCutlassType<half> {
    using type = cutlass::half_t;
};

template <>
struct ToCutlassType<__nv_bfloat16> {
    using type = cutlass::bfloat16_t;
};

// The operand checks both launchers share.
struct Problem {
    int M, N, K;
    bool a_per_token;
};

Problem checkOperands(TensorView output, TensorView A, TensorView B, TensorView a_scale,
                      TensorView b_scale) {
    CHECK_INPUT(A);
    CHECK_INPUT(B);
    CHECK_INPUT(output);
    CHECK_INPUT(a_scale);
    CHECK_INPUT(b_scale);
    CHECK_CONTIGUOUS_INPUT(A);
    CHECK_CONTIGUOUS_INPUT(B);
    CHECK_CONTIGUOUS_INPUT(output);
    CHECK_CONTIGUOUS_INPUT(a_scale);
    CHECK_CONTIGUOUS_INPUT(b_scale);
    CHECK_DIM(2, B);
    TVM_FFI_ICHECK(isOperandType(A.dtype()) && isOperandType(B.dtype()))
        << "scaled_mm: A and B must be " << kOperandName;
    TVM_FFI_ICHECK(a_scale.dtype().code == kDLFloat && a_scale.dtype().bits == 32 &&
                   b_scale.dtype().code == kDLFloat && b_scale.dtype().bits == 32)
        << "scaled_mm: a_scale and b_scale must be float32";

    // Flatten leading dimensions here to avoid framework-side reshapes.
    const int K = static_cast<int>(A.size(A.ndim() - 1));
    const int M = static_cast<int>(FLATTENED_ROWS(A));
    const int N = static_cast<int>(B.size(0));
    TVM_FFI_ICHECK(B.size(1) == K) << "scaled_mm: B is [N, K]; got K=" << B.size(1)
                                   << " for an A of K=" << K;
    TVM_FFI_ICHECK(K % 16 == 0 && N % 8 == 0)
        << "scaled_mm needs K % 16 == 0 (16-byte operand loads) and N % 8 == 0 (16-byte output "
           "stores), got N=" << N << " K=" << K;
    TVM_FFI_ICHECK(a_scale.numel() == M || a_scale.numel() == 1)
        << "scaled_mm: a_scale needs one float per row (" << M
        << ") or one per tensor (1), got " << a_scale.numel();
    TVM_FFI_ICHECK(b_scale.numel() == N) << "scaled_mm: b_scale needs one float per output "
                                            "channel (" << N << "), got " << b_scale.numel();
    TVM_FFI_ICHECK(output.numel() == static_cast<int64_t>(M) * N)
        << "scaled_mm: output must hold M*N elements";
    return Problem{M, N, K, a_scale.numel() == M};
}

}  // namespace

// Scaled GEMM launcher: out = act(a_scale ⊗ b_scale · (A @ Bᵀ) + bias), fp16/bf16 out.

void {{ func_name }}(TensorView output, TensorView A, TensorView B, TensorView a_scale,
                     TensorView b_scale, Optional bias_opt, int64_t activation_type) {
    const Problem p = checkOperands(output, A, B, a_scale, b_scale);
    if (p.M == 0) {
        return;
    }

    cudaStream_t stream = get_stream(A.device());

    DISPATCH_DLPACK_HALF_DTYPE(output.dtype(), c_type, [&] {
        using CutlassType = typename ToCutlassType<c_type>::type;
        const CutlassType* bias_ptr = nullptr;
        if (bias_opt.has_value()) {
            TensorView bias = bias_opt.value();
            CHECK_INPUT(bias);
            TVM_FFI_ICHECK(bias.numel() == p.N) << "scaled_mm: bias needs N elements";
            TVM_FFI_ICHECK(bias.dtype().code == output.dtype().code &&
                           bias.dtype().bits == output.dtype().bits)
                << "scaled_mm: bias must have the output dtype";
            bias_ptr = reinterpret_cast<const CutlassType*>(bias.data_ptr());
        }
        auto status = oasr::scaled_mm::dispatchScaledMm<Config, CutlassType, kStreamK>(
            static_cast<int>(activation_type), static_cast<const ElementAB*>(A.data_ptr()),
            static_cast<const ElementAB*>(B.data_ptr()),
            static_cast<const float*>(a_scale.data_ptr()), p.a_per_token,
            static_cast<const float*>(b_scale.data_ptr()), bias_ptr,
            reinterpret_cast<CutlassType*>(output.data_ptr()), p.M, p.N, p.K, p.K, p.K, p.N,
            stream);
        TVM_FFI_ICHECK(status == oasr::scaled_mm::ScaledMmStatus::SUCCESS)
            << "scaled_mm kernel failed (status " << static_cast<int>(status)
            << ") for M=" << p.M << " N=" << p.N << " K=" << p.K
            << " activation=" << activation_type;
        return true;
    });
}

